# ==========================================
# DiGlow Frontend - Client Environment Variables
# ==========================================

# Production API Base URL (point to your deployed backend Express server)
# Examples:
# For Vercel + Render: VITE_API_BASE_URL="https://diglow-api.onrender.com/api"
# For Custom Subdomain: VITE_API_BASE_URL="https://api.diglow.com/api"
# Leave empty for local development to use default Vite proxy (/api)
VITE_API_BASE_URL=

# Privacy-Conscious Analytics & Discovery (Phase 7)
# Google Analytics 4 Measurement ID (only loaded when user grants cookie consent)
# Example: VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GA_MEASUREMENT_ID=

# Google Search Console Verification Meta Tag Token
# Example: VITE_GSC_VERIFICATION="your_search_console_token_here"
VITE_GSC_VERIFICATION=
