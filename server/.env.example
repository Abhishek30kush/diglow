# ==============================================================================
# DiGlow Artisanal Candles — Environment Configuration Template
# Phase 15: Cash on Delivery (COD) Only Launch Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 14+)
# DATABASE_URL is used by Prisma Client for transactional and pooled queries.
# DIRECT_URL is used for running Prisma migrations against direct DB port.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/diglow_db?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/diglow_db?schema=public"

# Authentication Security (JSON Web Token)
# Secret key used for signing session tokens (Staff role tokens have type: 'STAFF', customers have type: 'CUSTOMER')
JWT_SECRET="replace_with_a_long_random_cryptographic_secret_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# Storefront Client Allowed Origin for CORS
# In production, specify exact storefront domains (e.g., "https://diglow.com,https://www.diglow.com")
CLIENT_URL="http://localhost:5173"

# Logistics & Delivery Fee Constants (in INR)
# Orders at or above FREE_DELIVERY_THRESHOLD receive free standard shipping (₹0 delivery fee).
FREE_DELIVERY_THRESHOLD=999
STANDARD_DELIVERY_FEE=99

# ==============================================================================
# PAYMENT GATEWAY POLICY — CASH ON DELIVERY (COD) ONLY LAUNCH
# ==============================================================================
# The initial launch strictly enforces Cash on Delivery (COD) only.
# Razorpay online payment controls are completely disabled on frontend and rejected on backend.
# You DO NOT need valid Razorpay API keys to run or test the COD application!
# The variables below are preserved for future post-launch reactivation audits:
RAZORPAY_KEY_ID="rzp_test_placeholder_for_future_phase"
RAZORPAY_KEY_SECRET="placeholder_secret_for_future_phase"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret_for_future_phase"

# ==============================================================================
# EMAIL NOTIFICATION SERVICE (SMTP Configuration)
# ==============================================================================
# Real email delivery is enabled when valid SMTP credentials are provided.
# If these variables are omitted, left empty, or invalid during local development:
# - notificationService automatically falls back to safe console simulation.
# - Secret tokens, delivery PINs, and passwords are never exposed in log output.
# - In automated test runs (NODE_ENV=test), a mock transport is automatically used.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp_username_or_api_key"
SMTP_PASS="smtp_password_or_token"
SMTP_FROM="DiGlow Artisanal Candles <orders@diglow.com>"

# Product Image Asset Storage
# Options: 'local' (files saved to public/uploads and served at /uploads) or 'cloud'
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
